{
  "name": "openi-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:relay": "node scripts/e2e-relay.mjs",
    "build": "npm run lint && vite build",
    "postbuild": "node gen-version.js && node prerender.js && node indexnow-submit.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx --max-warnings=9999",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "lint:hooks": "eslint . --ext .js,.jsx --rule 'react-hooks/rules-of-hooks: error' --no-eslintrc --plugin react-hooks",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^10.50.0",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-joyride": "^3.0.2",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^2.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.0.11",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.32",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --max-warnings=9999"
    ]
  }
}
